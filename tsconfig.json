{
  "compilerOptions": {
    "outDir": "./dist/",
    "allowJs": true,
	  "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "mocha"],
    "paths": {
      "@/*": ["./frontend/src/*"]
    }
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  }
}